                // "--dataset", "enron10",
                // "--split_count", "10",
                // "--dataset", "bitcoin_alpha",
                // "--split_count", "13",
                "--dataset", "bitcoin",
                "--split_count", "13",
                // "--dataset", "yelp_review",
                // "--split_count", "9",
                // "--dataset", "email_eu_core",
                // "--split_count", "8",
                // "--dataset", "mathoverflow",
                // "--split_count", "16",

                "--nhid", "8",
                "--nout", "8",

                "--aggregation", "deg", // deg att
                
                "--manifold", "Hyperboloid",
